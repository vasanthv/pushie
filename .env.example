# Required (the server refuses to start without it). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

MONGODB_URI=mongodb://localhost:27017/pushie-dev
PORT=3000

# Generate with: npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AWS SES, used for verification and password reset emails
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NO_REPLY_EMAIL=Pushie <noreply@example.com>
CONTACT_EMAIL=hello@example.com

# Optional: HTML/script snippet for analytics
ANALYTICS_SCRIPT=
