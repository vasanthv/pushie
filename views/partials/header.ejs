<%- include('toast'); -%>

<header>
	<a href="/" class="brand">
		<svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
			<path
				d="M78 38L72.4 20.88L49.04 28.48V3.83997H30.96V28.48L7.6 20.88L2 38L25.44 45.6L10.96 65.6L25.52 76.16L40 56.24L54.48 76.16L69.04 65.6L54.56 45.6L78 38Z"
				fill="currentColor"
			/>
		</svg>
		<span>pushie</span>
	</a>

	<nav>
		<% if(typeof user !== "undefined" && user !== null) { %>
		<a href="/" class="<%= page === 'home' ? 'on' : '' %>">home</a>
		<a href="/settings" class="<%= page === 'settings' ? 'on' : '' %>">settings</a>
		<button type="button" v-on:click="logOut()">log out</button>
		<% } else { %>
		<a href="/login" class="<%= page === 'login' ? 'on' : '' %>">log in</a>
		<a href="/signup" class="<%= page === 'signup' ? 'on' : '' %>">sign up</a>
		<% } %>
	</nav>
</header>

<% if(typeof heading !== "undefined" && heading) { %>
<h1 class="page-title"><%= heading %></h1>
<% } %>
