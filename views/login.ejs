<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>

	<body>
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header', { heading: 'Log in' }); -%>

			<form class="panel" v-on:submit.prevent="logIn">
				<div class="panel-body pad">
					<div class="field">
						<label for="username">Username</label>
						<input
							type="text"
							id="username"
							placeholder="username"
							autocomplete="username"
							v-model="authCreds.username"
						/>
					</div>
					<div class="field">
						<label for="password">Password</label>
						<input
							type="password"
							id="password"
							placeholder="password"
							autocomplete="current-password"
							v-model="authCreds.password"
						/>
					</div>
					<button type="submit" class="button block caps" v-bind:disabled="isSaving">Log in</button>
				</div>
			</form>

			<p class="alt">
				<button type="button" class="link" v-on:click="forgotPassword">Forgot password</button>
			</p>
			<p class="alt">No account yet? <a href="/signup">Sign up</a></p>
		</div>
		<%- include('partials/footer'); -%>
	</body>
</html>
