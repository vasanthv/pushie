<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>

	<body>
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header', { heading: 'Sign up' }); -%>

			<form class="form" v-on:submit.prevent="signUp">
				<div class="field">
					<label for="username">Username</label>
					<input type="text" id="username" autocomplete="username" v-model="newAccount.username" />
					<p class="hint">Letters, numbers and dashes. This is how others push to you.</p>
				</div>
				<div class="field">
					<label for="email">E-mail address</label>
					<input type="email" id="email" autocomplete="email" v-model="newAccount.email" />
				</div>
				<div class="field">
					<label for="password">Password</label>
					<input type="password" id="password" autocomplete="new-password" v-model="newAccount.password" />
					<p class="hint">At least 8 characters.</p>
				</div>
				<button type="submit" class="button block" v-bind:disabled="isSaving">Sign up</button>
			</form>

			<p class="alt">
				Already have an account? <a href="/login">Log in</a><br />
				By signing up you agree to our <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.
			</p>
		</div>
		<%- include('partials/footer'); -%>
	</body>
</html>
