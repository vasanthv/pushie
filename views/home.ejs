<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>

	<body>
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header'); -%> <% if(typeof user === "undefined" || user === null) { %>
			<!-- Logged out: the intro. Placeholder copy for now. -->
			<section class="intro">
				<h1>Get notified the moment something happens.</h1>
				<p>
					Pushie delivers short messages straight to your devices as browser push notifications. Wire it into a script,
					a cron job, a webhook or an agent &mdash; anything that can make an HTTP request can reach you.
				</p>
				<p>You decide who is allowed to push to you. Everything else is one API key and one POST request away.</p>
				<p class="cta">
					<a href="/signup" class="button">Create an account</a>
					<a href="/login" class="button secondary">Log in</a>
				</p>
			</section>
			<% } else { %>
			<!-- Logged in: everything pushed to this user, newest first. -->
			<div class="notice" v-if="pushPermission !== 'granted'">
				<span>Notifications are off on this device.</span>
				<button type="button" v-on:click="enableNotifications" v-bind:disabled="isSaving">Enable</button>
			</div>

			<section class="feed">
				<article class="push" v-for="(push, index) in pushes" v-bind:key="index">
					<p class="meta">
						<a v-bind:href="'/@' + push.from" class="from">@{{push.from}}</a>
						<span class="when">{{displayDate(push.date)}}</span>
					</p>
					<p class="text" v-html="linkify(push.text)"></p>
				</article>
			</section>

			<p class="empty" v-if="!isLoading && pushes.length === 0">
				Nothing here yet. Pushes show up as they arrive and are deleted after 24 hours.
				<a href="/settings">Create an API key</a> to start sending them.
			</p>

			<p class="loading" v-if="isLoading">Loading&hellip;</p>

			<button type="button" class="button secondary block" v-if="showLoadMore" v-on:click="pull()">Load more</button>
			<% } %>
		</div>
		<%- include('partials/footer'); -%>
	</body>
</html>
