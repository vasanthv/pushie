<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>

	<body>
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header', { heading: 'Settings' }); -%>

			<nav class="tabs">
				<button type="button" v-bind:class="{ on: tab === 'account' }" v-on:click="tab = 'account'">Account</button>
				<button type="button" v-bind:class="{ on: tab === 'users' }" v-on:click="tab = 'users'">Allowed users</button>
				<button type="button" v-bind:class="{ on: tab === 'keys' }" v-on:click="tab = 'keys'">API keys</button>
			</nav>

			<!-- 1. The account itself -->
			<section v-show="tab === 'account'">
				<div class="notice" v-if="myAccount.username && !myAccount.isEmailVerified">
					<span>Your e-mail is not verified.</span>
					<button type="button" v-on:click="resendVerification">Resend</button>
				</div>

				<form class="form" v-on:submit.prevent="updateAccount">
					<div class="field">
						<label for="username">Username</label>
						<input type="text" id="username" v-model="myAccount.username" />
					</div>
					<div class="field">
						<label for="email">E-mail address</label>
						<input type="email" id="email" v-model="myAccount.email" />
						<p class="hint">Changing this sends a fresh verification mail.</p>
					</div>
					<div class="field">
						<label for="password">New password</label>
						<input type="password" id="password" autocomplete="new-password" v-model="myAccount.password" />
						<p class="hint">Leave blank to keep your current password.</p>
					</div>
					<div class="field">
						<label for="bio">Bio</label>
						<textarea id="bio" rows="3" v-model="myAccount.bio"></textarea>
					</div>
					<button type="submit" class="button" v-bind:disabled="isSaving">Save changes</button>
				</form>
			</section>

			<!-- 2. Who may push to me -->
			<section v-show="tab === 'users'">
				<p class="hint">Only the people listed here can push to you.</p>

				<label class="check">
					<input type="checkbox" v-model="allowedAnyone" v-on:change="updateAllowedAnyone" />
					<span>Let anyone push to me</span>
				</label>

				<form class="form inline" v-on:submit.prevent="addAllowedUser">
					<input type="text" placeholder="username" v-model="newAllowedUser" />
					<button type="submit" class="button" v-bind:disabled="isSaving">Add</button>
				</form>

				<ul class="list">
					<li v-for="username in allowedUsers" v-bind:key="username">
						<a v-bind:href="'/@' + username">@{{username}}</a>
						<button
							type="button"
							class="link danger"
							v-if="username !== myAccount.username"
							v-on:click="removeAllowedUser(username)"
						>
							Remove
						</button>
						<span class="hint" v-else>you</span>
					</li>
				</ul>
			</section>

			<!-- 3. API keys -->
			<section v-show="tab === 'keys'">
				<p class="hint">
					Send an API key as the <code>x-api-key</code> header to push without logging in.
					<a href="https://github.com/vasanthv/pushie/blob/main/docs/API-DOCS.md" target="_blank" rel="noopener">
						Read the API docs</a
					>.
				</p>

				<button type="button" class="button" v-on:click="createApiKey" v-bind:disabled="isSaving">
					Create a new key
				</button>

				<ul class="list">
					<li v-for="key in apiKeys" v-bind:key="key">
						<code>{{key}}</code>
						<button type="button" class="link danger" v-on:click="deleteApiKey(key)">Delete</button>
					</li>
				</ul>
				<p class="hint" v-if="apiKeys.length === 0">No API keys yet.</p>
			</section>
		</div>
		<%- include('partials/footer'); -%>
	</body>
</html>
