<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>

	<body>
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header', { heading: `@${profile}` }); -%> <% if(bio) { %>
			<p class="bio"><%= bio %></p>
			<% } %> <% if(canPush) { %>
			<form class="form" v-on:submit.prevent="push(pushText, profile)">
				<div class="field">
					<label for="pushText">Push to @<%= profile %></label>
					<textarea id="pushText" rows="3" v-model="pushText" v-bind:maxlength="maxPushLength"></textarea>
					<p class="hint">{{charsLeft}} characters left</p>
				</div>
				<button type="submit" class="button" v-bind:disabled="isSaving">Push</button>
			</form>
			<% } else if(typeof user === "undefined" || user === null) { %>
			<p class="empty"><a href="/login">Log in</a> to push to @<%= profile %>.</p>
			<% } else { %>
			<p class="empty">@<%= profile %> has not allowed you to push to them.</p>
			<% } %>
		</div>
		<%- include('partials/footer'); -%>
	</body>
</html>
