{
	"name": "pushie",
	"version": "1.0.4",
	"description": "A social push notifications app.",
	"main": "init.js",
	"scripts": {
		"start": "node init.js",
		"api-dev": "DISABLE_CSRF=true node init.js",
		"gen:vapid": "node ./scripts/generate-vapid-keys.js",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [
		"web-push",
		"push-notifications"
	],
	"author": "Vasanth.V <hi@vasanthv.me>",
	"license": "MIT",
	"dependencies": {
		"@aws-sdk/client-ses": "^3.556.0",
		"axios": "^1.7.7",
		"body-parser": "^1.20.2",
		"connect-mongo": "^5.1.0",
		"cookie-parser": "^1.4.7",
		"ejs": "^3.1.10",
		"eslint": "^9.13.0",
		"express": "^4.19.2",
		"express-rate-limit": "^7.2.0",
		"express-session": "^1.18.0",
		"generate-api-key": "^1.0.2",
		"html-to-text": "^9.0.5",
		"linkify-html": "^4.2.0",
		"linkify-plugin-hashtag": "^4.2.0",
		"linkify-plugin-mention": "^4.2.0",
		"linkifyjs": "^4.2.0",
		"mongoose": "^8.3.2",
		"morgan": "^1.10.0",
		"randomstring": "^1.3.0",
		"uuid": "^14.0.2",
		"vue": "^3.4.25",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"globals": "^15.12.0",
		"prettier": "3.4.2"
	},
	"prettier": {
		"printWidth": 120,
		"singleQuote": false,
		"trailingComma": "es5",
		"tabWidth": 2,
		"useTabs": true,
		"overrides": [
			{
				"files": [
					"*.ejs"
				],
				"options": {
					"parser": "html"
				}
			}
		]
	}
}
